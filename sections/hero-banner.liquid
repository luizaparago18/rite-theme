<section class="hero hero--carousel" data-hero-carousel {% if section.blocks.size > 1 %}data-hero-autoplay="6000"{% endif %}>
  <div class="hero__slides">
    {% for block in section.blocks %}
      <div class="hero__slide is-image-only{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>

        <picture>
          {% if block.settings.mobile_image %}
            <source media="(max-width: 700px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }} 900w, {{ block.settings.mobile_image | image_url: width: 1400 }} 1400w">
          {% endif %}
          {% if block.settings.image %}
            <img class="hero__media"
                 src="{{ block.settings.image | image_url: width: 1600 }}"
                 srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                         {{ block.settings.image | image_url: width: 1100 }} 1100w,
                         {{ block.settings.image | image_url: width: 1600 }} 1600w,
                         {{ block.settings.image | image_url: width: 2000 }} 2000w"
                 sizes="100vw"
                 alt="{{ block.settings.image.alt | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% else %}
            <div class="rite-placeholder" style="width:100%; height:100%;">Imagem do banner<br>em produção</div>
          {% endif %}
        </picture>

        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="hero__ready-link" aria-label="Ver mais"></a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="Banner anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" data-hero-next aria-label="Próximo banner">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="hero__dots" data-hero-dots>
      {% for block in section.blocks %}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot aria-label="Ir para banner {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem — desktop (2000 x 750px)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Imagem — celular (1000 x 1250px)" },
        { "type": "url", "id": "link", "label": "Link do banner (pra onde a pessoa vai ao clicar)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
