<section class="hero hero--carousel" data-hero-carousel {% if section.blocks.size > 1 %}data-hero-autoplay="6000"{% endif %}>
  <div class="hero__slides">
    {% for block in section.blocks %}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
        {% if block.settings.video != blank %}
          <video class="hero__media" autoplay muted loop playsinline poster="{{ block.settings.image | image_url: width: 1600 }}">
            <source src="{{ block.settings.video.sources[1].url | default: block.settings.video.sources[0].url }}" type="video/mp4">
          </video>
        {% elsif block.settings.image %}
          <img class="hero__media"
               src="{{ block.settings.image | image_url: width: 1600 }}"
               srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                       {{ block.settings.image | image_url: width: 1100 }} 1100w,
                       {{ block.settings.image | image_url: width: 1600 }} 1600w,
                       {{ block.settings.image | image_url: width: 2000 }} 2000w"
               sizes="100vw"
               alt="{{ block.settings.image.alt | escape }}"
               loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {% endif %}

        <div class="hero__overlay"></div>

        <div class="hero__content">
          {% if block.settings.eyebrow != blank %}<p class="hero__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          <h1 class="hero__heading font-heading">{{ block.settings.heading | default: 'Com 3 produtos, você tá pronta.' }}</h1>
          {% if block.settings.subheading != blank %}<p class="hero__subheading">{{ block.settings.subheading }}</p>{% endif %}
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_url | default: '/collections/all' }}" class="btn btn--accent">{{ block.settings.button_label }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="Banner anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" data-hero-next aria-label="Próximo banner">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="hero__dots" data-hero-dots>
      {% for block in section.blocks %}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot aria-label="Ir para banner {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Texto pequeno (eyebrow)", "default": "SEU RITUAL DIÁRIO" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Com 3 produtos, você tá pronta." },
        { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Proteção, tratamento e praticidade num só ritual. Todo dia, sem excesso." },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Quero começar" },
        { "type": "url", "id": "button_url", "label": "Link do botão" },
        { "type": "image_picker", "id": "image", "label": "Imagem de fundo (ou poster do vídeo)" },
        { "type": "video", "id": "video", "label": "Vídeo de fundo (opcional — se preenchido, substitui a imagem)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
