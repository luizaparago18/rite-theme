<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__col">
        <p class="site-footer__brand font-heading">rite</p>
        <p>{{ section.settings.description | default: 'Beleza como ritual. Proteção, tratamento e praticidade em cada gesto.' }}</p>
        <div class="site-footer__social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M16 3v9.5a3.5 3.5 0 1 1-3-3.46V6a6 6 0 1 0 6 6V8.5a5 5 0 0 0 3-1V4.5a5 5 0 0 1-3-1.5H16Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="site-footer__col">
        <h4>a rite</h4>
        <ul>
          <li><a href="/pages/quem-somos">quem somos</a></li>
          <li><a href="{{ blog.url | default: '/blogs/news' }}">blog</a></li>
          <li><a href="https://forms.gle/epncSt4Q7bB35v1P8" target="_blank" rel="noopener">seja um rite creator (ugc)</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>ajuda</h4>
        <ul>
          <li><a href="/policies/refund-policy">trocas e devolução</a></li>
          <li><a href="/policies/shipping-policy">políticas de frete</a></li>
          <li><a href="/policies/privacy-policy">privacidade</a></li>
          <li><a href="/policies/terms-of-service">termos de uso</a></li>
          <li><a href="/pages/aviso-legal">aviso legal</a></li>
          <li><a href="/pages/contato">contato</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>suporte ao cliente</h4>
        <ul class="site-footer__support-list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{{ section.settings.support_text | default: 'Atendimento de segunda a sexta, 9h às 17h.' }}</span>
          </li>
          {% if section.settings.email != blank %}
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6l8.5 6.5L20.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {% endif %}
          {% if section.settings.whatsapp != blank %}
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 9.5c0 4 2.5 6.5 6.5 6.5.6 0 1-.5.9-1.1l-.3-1.3a1 1 0 0 0-1-.8l-1.2.2a5 5 0 0 1-3-3l.2-1.2a1 1 0 0 0-.8-1L8.5 7.5c-.6 0-1 .4-1 1v1z" fill="currentColor"/></svg>
              <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener">{{ section.settings.whatsapp }}</a>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>{{ shop.name }} · {{ 'now' | date: '%Y' }} · Todos os direitos reservados</span>
      <span>
        {% if section.settings.cnpj != blank %}CNPJ {{ section.settings.cnpj }} · {% endif %}
        desenvolvido por <a href="https://www.instagram.com/__flostudio" target="_blank" rel="noopener" style="text-decoration:underline;">Flo Studio</a>
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Descrição curta da marca" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "textarea", "id": "support_text", "label": "Texto de suporte (horário)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (formato: +5521976204366)" },
    { "type": "text", "id": "email", "label": "E-mail de contato" },
    { "type": "text", "id": "cnpj", "label": "CNPJ" }
  ]
}
{% endschema %}
