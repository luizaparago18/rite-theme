<section class="section">
  <div class="container">
    <h2 class="section__heading font-heading">{{ section.settings.heading | default: 'mais vendidos' }}</h2>

    <div class="product-grid">
      {% assign coll = section.settings.collection %}
      {% assign product_limit = section.settings.product_limit | default: 4 %}
      {% assign shown = 0 %}

      {% if coll != blank %}
        {% assign product_source = coll.products %}
      {% else %}
        {% assign product_source = collections.all.products %}
      {% endif %}

      {% for product in product_source limit: product_limit %}
        {% if forloop.first %}
          {% render 'product-card', product: product, badge: 'mais vendido' %}
        {% else %}
          {% render 'product-card', product: product %}
        {% endif %}
        {% assign shown = shown | plus: 1 %}
      {% endfor %}

      {% if shown == 0 %}
        {% for i in (1..4) %}{% render 'product-card' %}{% endfor %}
      {% endif %}
    </div>

    <div style="text-align:center; margin-top: var(--space-4);">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline" style="text-transform:lowercase;">ver todos os produtos</a>
    </div>
  </div>
</section>

