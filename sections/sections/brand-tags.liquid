<section class="club-dot-pattern brand-tags-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section__heading font-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="brand-tags__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="brand-tags__wrap">
      {% for block in section.blocks %}
        <span class="brand-tag" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Diferenciais da marca",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "o que nos diferencia" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo (opcional)", "default": "Beleza pensada com cuidado, do jeito Rite de ser." }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto da tag", "default": "vegano" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diferenciais da marca",
      "blocks": [
        { "type": "tag", "settings": { "text": "vegano" } },
        { "type": "tag", "settings": { "text": "multifuncional" } },
        { "type": "tag", "settings": { "text": "alta proteção" } },
        { "type": "tag", "settings": { "text": "testado dermatologicamente" } },
        { "type": "tag", "settings": { "text": "acompanha o seu ritmo" } },
        { "type": "tag", "settings": { "text": "toque seco" } }
      ]
    }
  ]
}
{% endschema %}
