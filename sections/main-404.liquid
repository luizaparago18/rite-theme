    <p class="error-404__body">Não encontramos o que você procurava, mas o resto do site tá aqui te esperando.</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary" style="text-transform:lowercase;">voltar pra home</a>
    <div class="error-404__links">
      <a href="{{ routes.all_products_collection_url }}">ver produtos</a>
      <a href="{{ blog.url | default: '/blogs/news' }}">ler o blog</a>
    </div>
  </div>
</section>

