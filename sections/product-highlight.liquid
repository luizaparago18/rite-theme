<section class="product-highlight" style="background: {{ section.settings.bg_color | default: '#F3DFC0' }};">
  <div class="product-highlight__grid">
    <div class="product-highlight__media">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {% else %}
        <div class="rite-placeholder" style="width:100%; height:100%;">Imagem em produção</div>
      {% endif %}
    </div>

    <div class="product-highlight__content">
      <h2 class="font-heading product-highlight__heading">{{ section.settings.heading | default: 'Um único produto para quem busca praticidade com sofisticação.' }}</h2>

      <div class="product-highlight__accordion">
        {% for block in section.blocks %}
          <details class="product-highlight__item">
            <summary>
              <span class="product-highlight__icon">
                {% case block.settings.icon %}
                  {% when 'leaf' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5 19c0-5 3-8 8-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                  {% when 'star' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3l2.4 6.5L21 11l-5 4 1.3 6.5L12 18l-5.3 3.5L8 15l-5-4 6.6-1.5L12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  {% when 'drop' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                {% endcase %}
              </span>
              <span class="product-highlight__label">{{ block.settings.title }}</span>
              <span class="product-highlight__toggle"></span>
            </summary>
            <div class="product-highlight__body">{{ block.settings.body }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Destaque do produto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo", "default": "#F3DFC0" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Um único produto para quem busca praticidade com sofisticação." }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Item do acordeão",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícone", "options": [
          { "value": "heart", "label": "Coração" },
          { "value": "leaf", "label": "Folha" },
          { "value": "star", "label": "Estrela" },
          { "value": "drop", "label": "Gota" }
        ], "default": "heart" },
        { "type": "text", "id": "title", "label": "Título do item", "default": "O que ele entrega" },
        { "type": "textarea", "id": "body", "label": "Texto", "default": "Descrição a preencher." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destaque do produto",
      "blocks": [
        { "type": "accordion_item", "settings": { "icon": "heart", "title": "o que ele entrega" } },
        { "type": "accordion_item", "settings": { "icon": "leaf", "title": "principais ativos" } },
        { "type": "accordion_item", "settings": { "icon": "drop", "title": "fragrância" } }
      ]
    }
  ]
}
{% endschema %}
