<section class="cart-page">
  {% if cart.item_count > 0 %}
    <div class="cart-page__header">
      <p class="cart-page__eyebrow">seu carrinho</p>
      <h1 class="font-heading cart-page__title">revise antes de seguir</h1>
    </div>

    <div class="container">
      {% form 'cart' %}
        <div class="cart-page__grid">
          <div class="cart-items-card">
            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item__image">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
                  {% endif %}
                </div>
                <div>
                  <p class="cart-item__title">{{ item.product.title }}</p>
                  {% if item.variant.title != 'Default Title' %}<p class="cart-item__variant">{{ item.variant.title }}</p>{% endif %}
                  <div class="cart-item__price-row">
                    <span>{{ item.final_price | money }}</span>
                    <span>×</span>
                    <input type="number" class="cart-item__qty-input" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0">
                  </div>
                </div>
                <button type="submit" name="remove" class="cart-item__remove" formaction="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">remover</button>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary">
            <p class="cart-summary__title">resumo</p>
            <div class="cart-summary__row">
              <span>subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <p class="cart-summary__note">Frete e descontos calculados no checkout.</p>
            <div class="cart-summary__brilhos">
              <span>✨</span>
              <span>essa compra também rende Brilhos pro seu Rite Clube</span>
            </div>
            <button type="submit" name="checkout" class="btn btn--primary btn--full" style="text-transform:lowercase;">finalizar compra</button>
          </div>
        </div>
      {% endform %}
    </div>
  {% else %}
    <div class="cart-empty">
      <div class="cart-empty-card">
        <p class="cart-empty-card__heading font-heading">ainda sem nada aqui.</p>
        <p class="cart-empty-card__body">Bora começar o ritual? Seus produtos favoritos estão a um clique de distância.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="text-transform:lowercase;">ver produtos</a>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{ "name": "Carrinho", "settings": [] }
{% endschema %}
