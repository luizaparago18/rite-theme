<section class="cart-page">
  {% if cart.item_count > 0 %}
    <div class="cart-page__header">
      <p class="cart-page__eyebrow">seu carrinho</p>
      <h1 class="font-heading cart-page__title">revise antes de seguir</h1>
    </div>

    <div class="container">
      {% form 'cart', cart %}
        <div class="cart-page__grid">
          <div class="cart-items-card">
            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item__image">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
                  {% endif %}
                </div>
                <div>
                  <p class="cart-item__title">{{ item.product.title }}</p>
                  {% if item.product.has_only_default_variant == false %}
                    <select class="cart-item__variant-select" data-cart-variant-select data-line="{{ forloop.index }}" data-quantity="{{ item.quantity }}">
                      {% for variant in item.product.variants %}
                        <option value="{{ variant.id }}" {% if variant.id == item.variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                          {{ variant.title }}{% unless variant.available %} (esgotado){% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {% endif %}
                  <div class="cart-item__price-row">
                    <span>{{ item.final_price | money }}</span>
                    <span>×</span>
                    <input type="number" class="cart-item__qty-input" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0">
                  </div>
                </div>
                {%- comment -%}
                  IMPORTANTE: este link fica FORA do formulário de quantidades (updates[]).
                  Antes era um <button formaction="..."> dentro do mesmo <form> dos campos
                  de quantidade em lote — isso fazia o navegador enviar todos os updates[]
                  junto com o remove, causando um conflito de índice (0-based vs 1-based)
                  que o Shopify resolvia errado, gerando "Cart Error: Cannot find variant".
                  Um <a> isolado evita esse problema por completo.
                {%- endcomment -%}
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item__remove">remover</a>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary">
            <p class="cart-summary__title">resumo</p>
            <div class="cart-summary__row">
              <span>subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <p class="cart-summary__note">Frete e descontos calculados no checkout.</p>

            {%- comment -%} Barra de progresso pro brinde: acima de R$198 no pedido, ganha uma necessaire {%- endcomment -%}
            {%- assign gift_threshold = 19800 -%}
            {%- if cart.total_price >= gift_threshold -%}
              <div class="cart-summary__gift cart-summary__gift--unlocked">
                <span>🎁</span>
                <span>Você já garantiu sua necessaire de brinde!</span>
              </div>
            {%- else -%}
              {%- assign gift_remaining = gift_threshold | minus: cart.total_price -%}
              {%- assign gift_percent = cart.total_price | times: 100 | divided_by: gift_threshold -%}
              <div class="cart-summary__gift">
                <p class="cart-summary__gift-text">Faltam <strong>{{ gift_remaining | money }}</strong> pra ganhar uma necessaire de brinde 🎁</p>
                <div class="cart-summary__gift-bar">
                  <div class="cart-summary__gift-fill" style="width: {{ gift_percent }}%;"></div>
                </div>
              </div>
            {%- endif -%}

            <div class="cart-summary__brilhos">
              <span>✨</span>
              <span>essa compra também rende Brilhos pro seu Rite Clube</span>
            </div>
            <button type="submit" name="checkout" class="btn btn--primary btn--full" style="text-transform:lowercase;">finalizar compra</button>
          </div>
        </div>
      {% endform %}
    </div>
  {% else %}
    <div class="cart-empty">
      <div class="cart-empty-card">
        <p class="cart-empty-card__heading font-heading">ainda sem nada aqui.</p>
        <p class="cart-empty-card__body">Bora começar o ritual? Seus produtos favoritos estão a um clique de distância.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="text-transform:lowercase;">ver produtos</a>
      </div>
    </div>
  {% endif %}
</section>

{%- comment -%}
  Troca de variante direto no carrinho. O Shopify não tem um jeito nativo de
  "trocar a variante de uma linha existente" — o caminho é remover a linha antiga
  (quantity: 0) e adicionar a nova variante com a mesma quantidade, depois recarregar
  a página. Isolado, não mexe no theme.js.
{%- endcomment -%}
<script>
  (function () {
    document.querySelectorAll('[data-cart-variant-select]').forEach(function (select) {
      var originalValue = select.value;

      select.addEventListener('change', function () {
        var line = select.getAttribute('data-line');
        var quantity = select.getAttribute('data-quantity');
        var newVariantId = select.value;

        select.disabled = true;

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ line: parseInt(line, 10), quantity: 0 })
        })
          .then(function () {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: newVariantId, quantity: parseInt(quantity, 10) })
            });
          })
          .then(function () {
            window.location.reload();
          })
          .catch(function () {
            select.disabled = false;
            select.value = originalValue;
            alert('Não conseguimos trocar a variante agora. Tenta de novo em instantes.');
          });
      });
    });
  })();
</script>

{% schema %}
{ "name": "Carrinho", "settings": [] }
{% endschema %}
