<section class="pdp">
  <div class="container pdp__grid">
    <div>
      <div class="pdp__gallery-main" data-pdp-gallery>
        {% for media in product.media %}
          <div class="pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide>
            {% case media.media_type %}
              {% when 'video' %}
                <video controls playsinline preload="metadata" poster="{{ media.preview_image | image_url: width: 800 }}">
                  <source src="{{ media.sources[1].url | default: media.sources[0].url }}" type="video/mp4">
                </video>
              {% else %}
                <img src="{{ media | image_url: width: 800 }}" alt="{{ media.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {% endcase %}
          </div>
        {% else %}
          <div class="rite-placeholder">Foto do produto<br>em produção</div>
        {% endfor %}

        {% if product.media.size > 1 %}
          <button class="pdp__gallery-arrow pdp__gallery-arrow--prev" data-pdp-prev aria-label="Mídia anterior">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="pdp__gallery-arrow pdp__gallery-arrow--next" data-pdp-next aria-label="Próxima mídia">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <span class="pdp__gallery-counter" data-pdp-counter>1 / {{ product.media.size }}</span>
        {% endif %}
      </div>
      {% if product.media.size > 1 %}
        <div class="pdp__thumbs" data-pdp-thumbs>
          {% for media in product.media %}
            <button class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb type="button">
              {% if media.media_type == 'video' %}
                <img src="{{ media.preview_image | image_url: width: 150 }}" alt="" loading="lazy">
                <span class="pdp__thumb-play" aria-hidden="true">▶</span>
              {% else %}
                <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" loading="lazy">
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div>
      {% if product.vendor != blank %}<p class="pdp__vendor">{{ product.vendor }}</p>{% endif %}

      {%- comment -%} 1. TÍTULO {%- endcomment -%}
      <h1 class="pdp__title font-heading">{{ product.title | default: 'Nome do produto' }}</h1>
      {% if product.metafields.custom.subtitulo != blank %}<p style="color:var(--color-gray); margin-bottom:12px;">{{ product.metafields.custom.subtitulo }}</p>{% endif %}

      {%- comment -%} 2. PREÇO {%- endcomment -%}
      <p class="pdp__price">
        {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{{ product.price | money }}{% else %}{{ product.price | money | default: 'R$ 00,00' }}{% endif %}
      </p>

      {%- comment -%} 3. VARIANTE + BOTÃO DE COMPRAR, logo após o preço (movido de baixo da descrição pra cá) {%- endcomment -%}
      <div class="pdp__purchase-card">
        {% form 'product', product %}
          {% if product.has_only_default_variant == false %}
            {% for option in product.options_with_values %}
              <div class="pdp__variant-group">
                <label class="pdp__variant-label">{{ option.name }}</label>
                <select class="pdp__variant-select" name="options[{{ option.name | escape }}]">
                  {% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}
                </select>
              </div>
            {% endfor %}
          {% endif %}

          {% if product.selling_plan_groups.size > 0 %}
            <div class="pdp__purchase-options">
              <label class="pdp__purchase-option"><input type="radio" name="purchase_option" value="one_time" checked> Comprar uma vez — {{ product.price | money }}</label>
              <label class="pdp__purchase-option"><input type="radio" name="purchase_option" value="subscription"> Assinar (Rite em Ciclo) — economize na recompra</label>
            </div>
          {% endif %}

          <div class="pdp__qty-row"><input type="number" class="pdp__qty-input" name="quantity" value="1" min="1"></div>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn--primary btn--full" style="text-transform:lowercase;" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}adicionar ao carrinho{% else %}esgotado{% endif %}
          </button>
        {% endform %}
      </div>

      {%- comment -%} 4. VÍDEOS UGC — movido de baixo do grid pra dentro da coluna, entre a compra e os accordions {%- endcomment -%}
      {% assign ugc_videos = product.metafields.custom.videos_ugc.value %}
      {% if ugc_videos.size > 0 %}
        <div class="pdp-ugc-block" style="margin-top: var(--space-3);">
          <p class="pdp-ugc-block__heading">rite na prática 💛</p>
          <div class="pdp-ugc-carousel" data-pdp-ugc-carousel>
            <div class="pdp-video-grid" data-pdp-ugc-track>
              {% for video_file in ugc_videos %}
                {% assign video_src = video_file.sources[0].url | default: video_file.url %}
                <div class="pdp-video-item">
                  <div class="pdp-video-item__media" data-pdp-ugc-video>
                    <video autoplay muted loop playsinline preload="metadata">
                      <source src="{{ video_src }}" type="video/mp4">
                    </video>
                    <span class="pdp-video-item__play" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </div>
                </div>
              {% endfor %}
            </div>
            {% if ugc_videos.size > 3 %}
              <button class="pdp-ugc-arrow pdp-ugc-arrow--prev" data-pdp-ugc-prev aria-label="Vídeos anteriores">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="pdp-ugc-arrow pdp-ugc-arrow--next" data-pdp-ugc-next aria-label="Mais vídeos">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {%- comment -%}
        5. ACCORDIONS nativos (details/summary, sem JS): Diferenciais / Como usar / Ingredientes.
        Se nenhum dos 3 metafields estiver preenchido ainda (produto não migrado), cai no
        fallback antigo e mostra a descrição corrida, pra não ficar com espaço em branco.
      {%- endcomment -%}
      {%- capture diferenciais -%}{{ product.metafields.custom.diferenciais.value }}{%- endcapture -%}
      {%- capture como_usar -%}{{ product.metafields.custom.como_usar.value }}{%- endcapture -%}
      {%- capture ingredientes -%}{{ product.metafields.custom.ingredientes.value }}{%- endcapture -%}

      {%- if diferenciais != blank or como_usar != blank or ingredientes != blank -%}
        <div class="pdp-accordion-list">
          {%- if diferenciais != blank -%}
            <details class="pdp-accordion">
              <summary>Diferenciais</summary>
              <div class="pdp__description">{{ diferenciais }}</div>
            </details>
          {%- endif -%}
          {%- if como_usar != blank -%}
            <details class="pdp-accordion">
              <summary>Como usar</summary>
              <div class="pdp__description">{{ como_usar }}</div>
            </details>
          {%- endif -%}
          {%- if ingredientes != blank -%}
            <details class="pdp-accordion">
              <summary>Ingredientes</summary>
              <div class="pdp__description">{{ ingredientes }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="pdp__description">{{ product.description | default: 'Descrição do produto entra aqui, seguindo o Guia de Voz da Rite.' }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="container">
    <div class="pdp__reviews-anchor">
      <div id="judgeme_product_reviews" data-id="{{ product.id }}">
        {% comment %} Fallback: caso o app use o método antigo de injeção via JS {% endcomment %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produto",
  "settings": [],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Produto" }
  ]
}
{% endschema %}
