<section class="pdp" data-product-id="{{ product.id }}">
  <div class="container">
    <div class="pdp__grid">

      {%- comment -%} FOTO / GALERIA — fica onde está, coluna esquerda no desktop {%- endcomment -%}
      <div class="pdp__media">
        {%- if product.media.size > 0 -%}
          <div class="pdp__gallery-main" data-pdp-gallery>
            {%- for media in product.media -%}
              <div class="pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide>
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  {{ media | media_tag: controls: true }}
                {%- else -%}
                  {{ media | image_url: width: 1200 | image_tag:
                      loading: forloop.first == false,
                      widths: '400,600,800,1000,1200',
                      sizes: '(max-width: 900px) 100vw, 50vw',
                      alt: media.alt | escape
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- if product.media.size > 1 -%}
              <button type="button" class="pdp__gallery-arrow pdp__gallery-arrow--prev" data-pdp-prev aria-label="Imagem anterior">‹</button>
              <button type="button" class="pdp__gallery-arrow pdp__gallery-arrow--next" data-pdp-next aria-label="Próxima imagem">›</button>
              <span class="pdp__gallery-counter" data-pdp-counter>1 / {{ product.media.size }}</span>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="pdp__thumbs" data-pdp-thumbs>
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="pdp__thumb{% if forloop.first %} is-active{% endif %}"
                  data-pdp-thumb
                  aria-label="Ver mídia {{ forloop.index }}"
                >
                  {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="pdp__thumb-play">▶</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="pdp__gallery-main">
            <div class="rite-placeholder">Sem imagem</div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} COLUNA DE INFO: título, preço, compra, UGC, accordions — nessa ordem {%- endcomment -%}
      <div class="pdp__info">

        {%- comment -%} 2. TÍTULO {%- endcomment -%}
        <h1 class="pdp__title">{{ product.title }}</h1>

        {%- comment -%} 3. PREÇO {%- endcomment -%}
        <div class="pdp__price">
          {%- if product.compare_at_price > product.price -%}
            <s>{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          {{ product.price | money }}
        </div>

        {%- comment -%} 4. VARIANTE + BOTÃO DE COMPRAR, logo após o preço {%- endcomment -%}
        {%- form 'product', product, class: 'pdp__purchase-card', data-rite-product-form: true -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          {%- if product.has_only_default_variant == false -%}
            {%- for option in product.options_with_values -%}
              <div class="pdp__variant-group">
                <label class="pdp__variant-label" for="rite-option-{{ option.position }}">{{ option.name }}</label>
                <select
                  class="pdp__variant-select"
                  id="rite-option-{{ option.position }}"
                  data-option-index="{{ option.position | minus: 1 }}"
                >
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <button
            type="submit"
            name="add"
            class="btn btn--primary btn--full"
            {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
          >
            <span data-buy-button-text>
              {%- if product.selected_or_first_available_variant.available -%}
                Adicionar ao carrinho
              {%- else -%}
                Esgotado
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}

        {%- comment -%} 5. VÍDEOS UGC — mesmo padrão autoplay-mudo + fullscreen no clique que o resto do site já usa {%- endcomment -%}
        {%- assign ugc_videos = product.metafields.custom.ugc_videos.value -%}
        {%- if ugc_videos != blank -%}
          <div class="pdp-ugc-block">
            <p class="pdp-ugc-block__heading" style="font-size: 18px;">O que estão dizendo</p>
            <div class="pdp-ugc-carousel" data-pdp-ugc-carousel>
              <div class="pdp-video-grid" data-pdp-ugc-track>
                {%- for video in ugc_videos -%}
                  <div class="pdp-video-item">
                    <div class="pdp-video-item__media" data-pdp-ugc-video>
                      <video
                        src="{{ video | file_url }}"
                        muted
                        autoplay
                        loop
                        playsinline
                        preload="metadata"
                      ></video>
                      <span class="pdp-video-item__play">▶</span>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
              <button type="button" class="pdp-ugc-arrow pdp-ugc-arrow--prev" data-pdp-ugc-prev aria-label="Vídeo anterior">‹</button>
              <button type="button" class="pdp-ugc-arrow pdp-ugc-arrow--next" data-pdp-ugc-next aria-label="Próximo vídeo">›</button>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} 6. ACCORDIONS nativos (details/summary), no mesmo padrão do .club-faq — sem JS {%- endcomment -%}
        <div class="pdp-accordion-list">
          {%- capture diferenciais -%}{{ product.metafields.custom.diferenciais.value }}{%- endcapture -%}
          {%- if diferenciais != blank -%}
            <details class="pdp-accordion">
              <summary>Diferenciais</summary>
              <div class="pdp__description">{{ diferenciais }}</div>
            </details>
          {%- endif -%}

          {%- capture como_usar -%}{{ product.metafields.custom.como_usar.value }}{%- endcapture -%}
          {%- if como_usar != blank -%}
            <details class="pdp-accordion">
              <summary>Como usar</summary>
              <div class="pdp__description">{{ como_usar }}</div>
            </details>
          {%- endif -%}

          {%- capture ingredientes -%}{{ product.metafields.custom.ingredientes.value }}{%- endcapture -%}
          {%- if ingredientes != blank -%}
            <details class="pdp-accordion">
              <summary>Ingredientes</summary>
              <div class="pdp__description">{{ ingredientes }}</div>
            </details>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

{%- comment -%} Dados de variante pro JS de seleção (acrescentado ao final do theme.js) {%- endcomment -%}
<script>
  window.riteProductVariants = {{ product.variants | json }};
</script>

{% schema %}
{
  "name": "PDP Rite",
  "settings": [],
  "presets": [
    {
      "name": "PDP Rite"
    }
  ]
}
{% endschema %}
