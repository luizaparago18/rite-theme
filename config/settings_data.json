tured__image-wrap\">\n          {% if forloop.first %}<span class=\"cl-featured__badge\">mais vendido</span>{% endif %}\n          {% if product.featured_image %}\n            <img src=\"{{ product.featured_image | image_url: width: 500 }}\" alt=\"{{ product.featured_image.alt | escape }}\" loading=\"lazy\">\n          {% endif %}\n        </a>\n        <p class=\"cl-featured__title\">{{ product.title }}</p>\n        <p class=\"cl-featured__price\">{{ product.price | money }}</p>\n        <a href=\"{{ product.url }}\" class=\"cl-featured__btn\">adicionar ao carrinho</a>\n      </div>\n      {% assign shown = shown | plus: 1 %}\n    {% endfor %}\n  </div>\n\n  {% if shown == 0 %}\n    <p style=\"text-align:center; color:#706C66; font-size:14px;\">nenhum produto cadastrado ainda.</p>\n  {% endif %}\n\n  <div class=\"cl-featured__cta-wrap\">\n    <a href=\"/collections/all\" class=\"cl-featured__cta\">ver todos os produtos</a>\n  </div>\n</div>"
